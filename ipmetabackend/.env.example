# Port the NestJS server listens on.
PORT=4000

# Personal access token used to authenticate against the GitHub REST API.
# Optional for local development (unauthenticated requests are capped at
# 60/hour), but strongly recommended once deployed. See the README for how
# to generate one.
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGIN=http://localhost:3000

# How long GitHub responses are cached in memory, in milliseconds.
CACHE_TTL_MS=300000
